# docker compose için ortam değişkenleri (hepsi isteğe bağlıdır; varsayılanlar çalışır)
POSTGRES_USER=zimmet
POSTGRES_PASSWORD=zimmet_pass
POSTGRES_DB=zimmet
DB_PORT=5440

# Üretimde mutlaka değiştirin (en az 32 karakter)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@gop.edu.tr
ADMIN_PASSWORD=Admin123!

# true: ilk açılışta örnek kullanıcı ve cihazlar yüklenir
SEED_DEMO=true
# Giriş ekranında demo hesap butonları görünsün mü
VITE_DEMO_LOGIN=true

WEB_PORT=8080
API_PORT=3000
# QR kodlarının işaret ettiği adres (telefonla okutunca açılacak site)
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
